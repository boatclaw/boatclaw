{
  "name": "boatclaw",
  "version": "0.3.5",
  "description": "AI-powered task automation for development teams - Open Source",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "boatclaw": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "automation",
    "ai",
    "trello",
    "jira",
    "linear",
    "github",
    "claude",
    "cursor",
    "open-source"
  ],
  "author": "Boatclaw <hello@boatclaw.dev>",
  "license": "MIT",
  "homepage": "https://boatclaw.dev",
  "bugs": {
    "url": "https://github.com/boatclaw/boatclaw/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boatclaw/boatclaw.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "axios": "^1.7.0",
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "inquirer": "^13.4.1",
    "inquirer-file-selector": "^1.0.1",
    "js-yaml": "^4.1.0",
    "ora": "^9.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.0",
    "prettier": "^3.3.0",
    "tsup": "^8.1.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
