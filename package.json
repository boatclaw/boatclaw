{
  "name": "boatclaw",
  "version": "0.5.18",
  "description": "AI-powered task automation for development teams - Open Source",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "boatclaw": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "automation",
    "ai",
    "trello",
    "jira",
    "linear",
    "github",
    "claude",
    "cursor",
    "open-source"
  ],
  "author": "Boatclaw <hello@boatclaw.dev>",
  "license": "MIT",
  "homepage": "https://boatclaw.dev",
  "bugs": {
    "url": "https://github.com/boatclaw/boatclaw/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boatclaw/boatclaw.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "axios": "^1.7.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "inquirer": "^9.3.0",
    "inquirer-file-selector": "^1.0.1",
    "js-yaml": "^4.1.0",
    "ora": "^8.0.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
